# Windows scripts must have CRLF on every checkout (cmd goto/labels break on LF-only .bat files)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
# Notepad on Server 2016 cannot show LF-only files: the template the owner edits there is CRLF
deploy/config.install.yaml text eol=crlf
*.json text eol=lf
